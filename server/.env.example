# 复制本文件为 server/.env 后填写；.env 已被 .gitignore 忽略，不会提交。
#
# 常见邮箱的 SMTP 参数：
#   QQ 邮箱   smtp.qq.com   465  SMTP_SECURE=true
#   163 邮箱  smtp.163.com  465  SMTP_SECURE=true
#   Gmail     smtp.gmail.com 465  SMTP_SECURE=true（需要应用专用密码）
#
# 全部留空时不发真实邮件：开发环境把验证码打印到后端控制台，并自动填进页面。
# 要真实发信，去掉下面对应行的注释并填成自己的值。

# 示例（QQ 邮箱）：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@qq.com
# SMTP_PASS=your-smtp-auth-code
# MAIL_FROM=your-account@qq.com

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=

# 注意：这里是邮箱后台生成的「SMTP 授权码」，不是邮箱登录密码！
SMTP_PASS=

# 发件人；留空时使用 SMTP_USER。QQ / 163 通常要求与 SMTP_USER 一致
MAIL_FROM=

# auto  ：配好 SMTP 就真实发送；没配则开发环境把验证码打印到后端控制台（默认）
# true  ：强制使用控制台（生产环境会忽略，防止验证码泄露）
# false ：强制真实发送；未配置 SMTP 时发送接口会报错
EMAIL_DEV_MODE=auto

# ── 账号初始密码 ───────────────────────────────────────────
# 管理员初始密码：只在首次创建 admin 时使用；留空时随机生成并写回本文件。
ADMIN_PASSWORD=
# 演示账号统一密码（公开演示用，可自行修改）
DEMO_PASSWORD=Demo@2026!

# ── AI 辅助记账 ─────────────────────────────────────────────
# 默认 mock：本地规则解析 + 本地 OCR，完全不联网、不上传账目。
#
# 想用免费云模型，任选下面一种（都走 OpenAI 兼容协议），填好后重启后端：
#
# 1) OpenRouter（有免费模型，注意每日额度）
#    注册：https://openrouter.ai/keys
#    免费模型列表：https://openrouter.ai/models?max_price=0
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=（从免费列表里复制，例如某个以 :free 结尾的模型）
# AI_API_KEY=（你的 OpenRouter key）
#
# 2) Google Gemini（有免费额度，国内网络可能连不上）
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=（你的 Gemini key）
#
# 3) 智谱 GLM-4-Flash（国内可直连，有免费额度，以官网为准）
# AI_PROVIDER=openai
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash
# AI_API_KEY=（智谱开放平台 key）
#
# 4) 其他 OpenAI 兼容服务（硅基流动等）：AI_PROVIDER=openai，自行填写 AI_BASE_URL。
#
# 密钥只放在 server/.env（已 gitignore），绝不下发前端。
# 云模型不可用、超时或额度用完时，后端会自动回退本地规则，不会阻塞记账。
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=25000

# 免费额度部署（1–5 人）建议保持下面两个 auto：固定问答、能识别的小票都不消耗额度。
# chat:   auto = 规则先答，答不了再调云端（默认）｜cloud = 云端优先｜rule = 只用规则
# receipt:auto = 本地 OCR 出金额就不调云端（默认）｜cloud = 云端再提取一次｜rule = 只用本地
AI_CHAT_MODE=auto
AI_RECEIPT_MODE=auto
# 全局每日云端调用上限（所有用户合计，0 = 不限制）；建议设为供应商日额度的 80%。
# 用满后自动回退本地规则，不会阻塞记账。
AI_DAILY_CLOUD_LIMIT=200

# 本地 OCR 语言包（chi_sim + eng）首次识别时下载，缓存在 server/data/tessdata/。
# 默认用 projectnaptha 静态镜像；网络不通或需要完全离线时，把
# chi_sim.traineddata.gz、eng.traineddata.gz 放到一个目录，再指向它：
# OCR_LANG_PATH=D:/path/to/tessdata
# 也可以填其他镜像地址，例如 https://cdn.jsdelivr.net/npm/@tesseract.js-data/chi_sim/4.0.0
OCR_LANG_PATH=
